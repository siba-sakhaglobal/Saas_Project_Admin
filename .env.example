# SaaS Project Admin — Environment Variables
# Copy this file to .env and fill in your values

# API Base URL — your CMS backend server
REACT_APP_API_URL=https://your-cms-api.example.com

# Project API Key & Secret (get from https://sakhaglobal.com)
REACT_APP_API_KEY=sk_live_YOUR_KEY_HERE
REACT_APP_API_SECRET=sec_YOUR_SECRET_HERE

# Dev server port (optional)
PORT=3003
DANGEROUSLY_DISABLE_HOST_CHECK=true
